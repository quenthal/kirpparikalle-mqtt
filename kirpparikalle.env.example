# MQTT broker (MQTT_HOST is required)
MQTT_HOST=mqtt.example.lan
MQTT_PORT=1883
MQTT_USER=mqtt
MQTT_PASSWORD=CHANGE_ME
MQTT_CLIENT_ID=kirpparikalle-monitor

# Poll sales every 5 minutes while the reservation is active
# and the shop is open.
POLL_SECONDS=300

# Kirppari-Kalle animates the balance after page load.
SALES_SETTLE_MS=5000

# One extra sales read this many minutes after closing time.
FINAL_READ_DELAY_MINUTES=10

# Exit (and let systemd restart) after this many failed cycles in a row.
MAX_CONSECUTIVE_FAILURES=6

# Keep the Kirppari-Kalle session alive with a light page load (0 = off).
KEEPALIVE_MINUTES=60

# Optional automatic re-login when the session has expired.
# Use a password you do not use elsewhere; keep this file chmod 600.
#KK_USERNAME=
#KK_PASSWORD=
# Only needed if the account has several shops (part of the name is enough).
#KK_SHOP=
#RELOGIN_MIN_INTERVAL_HOURS=6

# MQTT topics
MQTT_STATE_TOPIC=kirpparikalle/state
MQTT_UPDATE_TOPIC=kirpparikalle/update
MQTT_STATUS_TOPIC=kirpparikalle/status
MQTT_RESERVATION_TOPIC=kirpparikalle/reservation
MQTT_AUTH_TOPIC=kirpparikalle/auth

# Home Assistant MQTT Discovery
HA_DISCOVERY_PREFIX=homeassistant
HA_DEVICE_ID=kirpparikalle_monitor

# Runtime data
KK_DATA_DIR=/var/lib/kirpparikalle
KK_AUTH_STATE_FILE=/var/lib/kirpparikalle/auth.json
KK_MONITOR_STATE_FILE=/var/lib/kirpparikalle/monitor_state.json
